---
import PageTitle from "~/components/page-title.astro";
import Shell from "~/layouts/shell.astro";
import { frens } from "~/ring";
---

<Shell title="hayden@web ~/ring" wide>
  <PageTitle title="Webring" description="My friends and their 88x31s!" />

  <div class="max-w-2xl w-full mx-auto flex flex-col gap-2 px-4">
    <span class="font-bold text-lg text-blue">Webring</span>

    <div class="grid grid-cols-3 xs:grid-cols-4 md:grid-cols-6 sm:grid-cols-5 items-center gap-4">
      {frens.map(fren => (
        <a href={fren.url}>
          <img
            src={fren.img}
            class="rendering-pixelated"
            width={88}
            height={31}
            alt={fren.name}
          />
        </a>
      ))}
    </div>
    <div class="p-2 bg-base01 block">
      <p>Wanna add me to yours? Here's my badge!</p>
      <img
        src={`/88x31/hayden.png`}
        class="rendering-pixelated"
        width={88}
        height={31}
        alt="Hayden"
      />
    </div>
  </div>
</Shell>
