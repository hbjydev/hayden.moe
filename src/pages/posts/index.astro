---
import { getCollection } from "astro:content";
import FormattedDate from "~/components/formatted-date.astro";
import Shell from "~/layouts/shell.astro";

const posts = await getCollection('posts', (post) => !post.data.unlisted);
---

<Shell title="hayden@web ~/posts" wide>
  <div class="w-full flex items-center justify-center pb-4 border-b border-line">
    <div class="prose flex flex-col max-w-2xl px-4 w-full mx-auto">
      <h1>Posts</h1>
      <span class="text-sm text-muted">My blog archive</span>
    </div>
  </div>

  <div class="py-5 md:max-w-2xl w-full mx-auto">
    <ul class="divide-y divide-line px-0 md:px-4">
      {posts.sort((a, b) => b.id.localeCompare(a.id)).map((post) => (
        <li class="py-4 first:pt-0 px-4 md:px-0">
          <a href={`/posts/${post.id}`} class="flex flex-col">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center">
              <span class="font-bold">{post.data.title}</span>
              <span class="text-muted">
                <FormattedDate date={post.data.pubDate} />
              </span>
            </div>
            <p class="text-sm text-muted">{post.data.description}</p>
          </a>
        </li>
      ))}
    </ul>
  </div>
</Shell>
